<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.AgendarCitaController"
        stylesheets="@../css/mediappoint.css"
        styleClass="dashboard-root"
        prefWidth="1050"
        prefHeight="680">

    <left>
        <VBox
                prefWidth="220"
                spacing="8"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="28"
                        right="18"
                        bottom="22"
                        left="18"/>
            </padding>

            <Label
                    text="MediAppoint"
                    styleClass="sidebar-brand"/>

            <Label
                    text="GESTIÓN DE CITAS MÉDICAS"
                    styleClass="sidebar-subtitle"/>

            <Region prefHeight="25"/>

            <Button
                    text="Inicio"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"
                    onAction="#volverDashboard"/>

            <Button
                    text="Agendar cita"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="Mis citas"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"/>

            <Button
                    text="Mi perfil"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"/>
                    

            <Region VBox.vgrow="ALWAYS"/>

            <Button
                    text="Volver al inicio"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="logout-button"
                    onAction="#volverDashboard"/>

        </VBox>
    </left>

    <top>
        <HBox
                alignment="CENTER_LEFT"
                prefHeight="82"
                spacing="15"
                styleClass="dashboard-header">

            <padding>
                <Insets
                        top="15"
                        right="28"
                        bottom="15"
                        left="28"/>
            </padding>

            <Label
                    text="Agendar cita médica"
                    styleClass="dashboard-page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="3">

                <Label
                        fx:id="lblNombreUsuario"
                        text="Paciente"
                        styleClass="dashboard-user-name"/>

                <Label
                        text="PACIENTE"
                        styleClass="dashboard-user-role"/>

            </VBox>

        </HBox>
    </top>

    <center>
        <VBox
                spacing="22"
                styleClass="dashboard-content">

            <padding>
                <Insets
                        top="30"
                        right="40"
                        bottom="35"
                        left="40"/>
            </padding>

            <VBox spacing="5">

                <Label
                        text="Nueva cita"
                        styleClass="welcome-title"/>

                <Label
                        text="Selecciona los datos de tu atención médica. Los horarios se actualizan según la disponibilidad."
                        wrapText="true"
                        styleClass="welcome-subtitle"/>

            </VBox>

            <VBox
                    spacing="20"
                    maxWidth="720"
                    styleClass="dashboard-card">

                <padding>
                    <Insets
                            top="25"
                            right="28"
                            bottom="28"
                            left="28"/>
                </padding>

                <Label
                        text="Datos de la cita"
                        styleClass="dashboard-section-title"/>

                <GridPane
                        hgap="18"
                        vgap="9">

                    <Label
                            text="Especialidad"
                            styleClass="field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                    <Label
                            text="Establecimiento"
                            styleClass="field-label"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                    <ComboBox
                            fx:id="cmbEspecialidad"
                            promptText="Selecciona una especialidad"
                            prefWidth="310"
                            styleClass="auth-combo"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <ComboBox
                            fx:id="cmbEstablecimiento"
                            promptText="Selecciona un establecimiento"
                            prefWidth="310"
                            styleClass="auth-combo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                    <Label
                            text="Médico"
                            styleClass="field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                    <Label
                            text="Fecha"
                            styleClass="field-label"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                    <ComboBox
                            fx:id="cmbMedico"
                            promptText="Selecciona un médico"
                            prefWidth="310"
                            disable="true"
                            styleClass="auth-combo"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <DatePicker
                            fx:id="dpFecha"
                            prefWidth="310"
                            disable="true"
                            styleClass="auth-date-picker"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                    <Label
                            text="Horario disponible"
                            styleClass="field-label"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="4"/>

                    <ComboBox
                            fx:id="cmbHorario"
                            promptText="Selecciona un horario"
                            prefWidth="310"
                            disable="true"
                            styleClass="auth-combo"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="5"/>

                </GridPane>

                <VBox spacing="7">

                    <Label
                            text="Motivo de consulta"
                            styleClass="field-label"/>

                    <TextArea
                            fx:id="txtMotivoConsulta"
                            promptText="Describe brevemente el motivo de tu consulta"
                            prefRowCount="3"
                            wrapText="true"
                            styleClass="appointment-text-area"/>

                </VBox>

                <Label
                        fx:id="lblMensaje"
                        text=""
                        wrapText="true"
                        styleClass="error-message"/>

                <HBox
                        alignment="CENTER_RIGHT"
                        spacing="12">

                    <Button
                            text="Cancelar"
                            prefWidth="130"
                            prefHeight="42"
                            styleClass="secondary-button"
                            onAction="#volverDashboard"/>

                    <Button
        fx:id="btnConfirmar"
        text="Confirmar cita"
        prefWidth="170"
        prefHeight="42"
        disable="true"
        styleClass="primary-button"
        onAction="#confirmarCita"/>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>