<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.citasmedicas.controller.DashboardMedicoController"
        prefWidth="1280"
        prefHeight="780"
        styleClass="doctor-root"
        stylesheets="@../css/mediappoint.css">

    <left>

        <VBox
                prefWidth="235"
                spacing="12"
                styleClass="doctor-sidebar">

            <padding>
                <Insets top="30" right="18" bottom="24" left="18"/>
            </padding>

            <Label
                    text="MediAppoint"
                    styleClass="doctor-brand"/>

            <Label
                    text="PORTAL MÉDICO"
                    styleClass="doctor-portal-label"/>

            <Separator styleClass="doctor-separator"/>

            <Label
                    text="GESTIÓN CLÍNICA"
                    styleClass="doctor-menu-label"/>

            <Button
                    text="●   Mi agenda"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="doctor-sidebar-button-active"
                    onAction="#actualizarAgenda"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox
                    spacing="3"
                    styleClass="doctor-sidebar-profile">

                <padding>
                    <Insets top="12" right="12" bottom="12" left="12"/>
                </padding>

                <Label
                        fx:id="lblNombreMedico"
                        text="Médico"
                        styleClass="doctor-sidebar-name"/>

                <HBox spacing="5">

                    <Label
                            text="Registro:"
                            styleClass="doctor-sidebar-detail"/>

                    <Label
                            fx:id="lblCedulaProfesional"
                            text="-"
                            styleClass="doctor-sidebar-detail"/>

                </HBox>

            </VBox>

            <Button
                    text="Cerrar sesión"
                    maxWidth="Infinity"
                    prefHeight="38"
                    styleClass="doctor-logout-button"
                    onAction="#cerrarSesion"/>

        </VBox>

    </left>

    <center>

        <VBox
                spacing="20"
                styleClass="doctor-content">

            <padding>
                <Insets top="30" right="36" bottom="30" left="36"/>
            </padding>

            <!-- ENCABEZADO -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="16">

                <VBox spacing="4">

                    <Label
                            text="Agenda médica"
                            styleClass="doctor-page-title"/>

                    <Label
                            text="Organiza y consulta las citas asignadas a tus pacientes."
                            styleClass="doctor-page-subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="↻  Actualizar agenda"
                        styleClass="doctor-primary-button"
                        onAction="#actualizarAgenda"/>

            </HBox>

            <!-- RESUMEN -->

            <HBox spacing="14">

                <VBox
                        spacing="4"
                        HBox.hgrow="ALWAYS"
                        styleClass="doctor-stat-card doctor-stat-total">

                    <padding>
                        <Insets top="16" right="18" bottom="16" left="18"/>
                    </padding>

                    <Label
                            text="TOTAL DE CITAS"
                            styleClass="doctor-stat-label"/>

                    <Label
                            fx:id="lblTotalCitas"
                            text="0"
                            styleClass="doctor-stat-value"/>

                    <Label
                            text="Agenda registrada"
                            styleClass="doctor-stat-description"/>

                </VBox>

                <VBox
                        spacing="4"
                        HBox.hgrow="ALWAYS"
                        styleClass="doctor-stat-card doctor-stat-programmed">

                    <padding>
                        <Insets top="16" right="18" bottom="16" left="18"/>
                    </padding>

                    <Label
                            text="PROGRAMADAS"
                            styleClass="doctor-stat-label"/>

                    <Label
                            fx:id="lblProgramadas"
                            text="0"
                            styleClass="doctor-stat-value"/>

                    <Label
                            text="Pendientes de atención"
                            styleClass="doctor-stat-description"/>

                </VBox>

                <VBox
                        spacing="4"
                        HBox.hgrow="ALWAYS"
                        styleClass="doctor-stat-card doctor-stat-cancelled">

                    <padding>
                        <Insets top="16" right="18" bottom="16" left="18"/>
                    </padding>

                    <Label
                            text="CANCELADAS"
                            styleClass="doctor-stat-label"/>

                    <Label
                            fx:id="lblCanceladas"
                            text="0"
                            styleClass="doctor-stat-value"/>

                    <Label
                            text="Citas no vigentes"
                            styleClass="doctor-stat-description"/>

                </VBox>

            </HBox>

            <!-- FILTROS -->

            <VBox
                    spacing="12"
                    styleClass="doctor-filter-panel">

                <padding>
                    <Insets top="16" right="18" bottom="16" left="18"/>
                </padding>

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="2">

                        <Label
                                text="Buscar en la agenda"
                                styleClass="doctor-section-title"/>

                        <Label
                                text="Localiza rápidamente una cita por paciente o información médica."
                                styleClass="doctor-section-description"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label
                            text="Filtros"
                            styleClass="doctor-filter-indicator"/>

                </HBox>

                <HBox
                        spacing="10"
                        alignment="CENTER_LEFT">

                    <TextField
                            fx:id="txtBuscar"
                            promptText="Buscar paciente, especialidad, establecimiento o motivo..."
                            HBox.hgrow="ALWAYS"
                            prefHeight="40"
                            styleClass="doctor-search-field"/>

                    <ComboBox
                            fx:id="cmbEstado"
                            prefWidth="160"
                            prefHeight="40"
                            styleClass="doctor-filter-combo"/>

                    <ComboBox
                            fx:id="cmbFecha"
                            prefWidth="140"
                            prefHeight="40"
                            styleClass="doctor-filter-combo"/>

                    <Button
                            text="Limpiar"
                            prefHeight="40"
                            styleClass="doctor-secondary-button"
                            onAction="#limpiarFiltros"/>

                </HBox>

            </VBox>

            <!-- TÍTULO AGENDA -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="8">

                <VBox spacing="2">

                    <Label
                            text="Citas"
                            styleClass="doctor-section-title"/>

                    <Label
                            text="Información de pacientes y consultas asignadas."
                            styleClass="doctor-section-description"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox
                        spacing="5"
                        alignment="CENTER">

                    <Label
                            text="Mostrando"
                            styleClass="doctor-count-text"/>

                    <Label
                            fx:id="lblCantidadCitas"
                            text="0"
                            styleClass="doctor-count-badge"/>

                    <Label
                            text="citas"
                            styleClass="doctor-count-text"/>

                </HBox>

            </HBox>

            <Label
                    fx:id="lblMensaje"
                    text=""
                    visible="false"
                    managed="false"
                    wrapText="true"
                    styleClass="doctor-message"/>

            <!-- LISTA DE CITAS -->

            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="doctor-appointments-scroll">

                <content>

                    <VBox
                            fx:id="contenedorCitas"
                            spacing="12">

                        <padding>
                            <Insets top="2" right="8" bottom="18" left="2"/>
                        </padding>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>