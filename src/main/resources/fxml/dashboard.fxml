<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.DashboardController"
        stylesheets="@../css/mediappoint.css"
        styleClass="dashboard-root"
        prefWidth="1180"
        prefHeight="720">

    <!-- =========================================================
                         MENÚ LATERAL
         ========================================================= -->

    <left>

        <VBox
                prefWidth="235"
                spacing="7"
                styleClass="sidebar">

            <padding>
                <Insets top="30" right="18" bottom="22" left="18"/>
            </padding>

            <!-- Marca -->

            <VBox spacing="3">

                <Label
                        text="MediAppoint"
                        styleClass="sidebar-brand"/>

                <Label
                        text="PORTAL DEL PACIENTE"
                        styleClass="sidebar-subtitle"/>

            </VBox>

            <Region prefHeight="28"/>

            <Label
                    text="NAVEGACIÓN"
                    styleClass="sidebar-section-label"/>

            <Region prefHeight="4"/>

            <Button
                    text="⌂   Inicio"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="+   Agendar cita"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#abrirAgendarCita"/>

            <Button
                    text="▣   Mis citas"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#abrirMisCitas"/>

            <Button
                    text="◷   Historial"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#abrirHistorial"/>

            <Button
                    text="●   Mi perfil"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#abrirPerfil"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Usuario -->

            <VBox
                    spacing="4"
                    styleClass="sidebar-user-card">

                <padding>
                    <Insets top="13" right="14" bottom="13" left="14"/>
                </padding>

                <Label
                        text="PACIENTE"
                        styleClass="sidebar-user-role"/>

                <Label
                        fx:id="lblNombreUsuario"
                        text="Usuario"
                        wrapText="true"
                        styleClass="sidebar-user-name"/>

            </VBox>

            <Region prefHeight="5"/>

            <Separator styleClass="sidebar-separator"/>

            <Button
                    text="↪   Cerrar sesión"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="logout-button"
                    onAction="#cerrarSesion"/>

        </VBox>

    </left>

    <!-- =========================================================
                            CABECERA
         ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                prefHeight="76"
                spacing="15"
                styleClass="dashboard-header">

            <padding>
                <Insets top="14" right="32" bottom="14" left="32"/>
            </padding>

            <VBox spacing="2">

                <Label
                        text="Panel principal"
                        styleClass="dashboard-page-title"/>

                <Label
                        text="Resumen de tu atención médica"
                        styleClass="page-header-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="3">

                <Label
                        text="SESIÓN ACTIVA"
                        styleClass="header-session-label"/>

                <Label
                        fx:id="lblRolUsuario"
                        text="PACIENTE"
                        styleClass="dashboard-user-role"/>

            </VBox>

        </HBox>

    </top>

    <!-- =========================================================
                           CONTENIDO
         ========================================================= -->

    <center>

        <VBox
                spacing="22"
                styleClass="dashboard-content">

            <padding>
                <Insets top="30" right="34" bottom="32" left="34"/>
            </padding>

            <!-- =================================================
                              BIENVENIDA
                 ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="20"
                    styleClass="patient-welcome-panel">

                <padding>
                    <Insets top="22" right="24" bottom="22" left="24"/>
                </padding>

                <VBox spacing="6">

                    <Label
                            text="BIENVENIDO A MEDIAPPOINT"
                            styleClass="welcome-eyebrow"/>

                    <Label
                            fx:id="lblBienvenida"
                            text="Bienvenido"
                            styleClass="welcome-title"/>

                    <Label
                            text="Administra tus citas y consulta tu información médica desde un solo lugar."
                            wrapText="true"
                            styleClass="welcome-subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="+  Agendar nueva cita"
                        prefWidth="185"
                        prefHeight="44"
                        styleClass="patient-primary-button"
                        onAction="#abrirAgendarCita"/>

            </HBox>

            <!-- =================================================
                         RESUMEN DE INFORMACIÓN
                 ================================================= -->

            <VBox spacing="12">

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="3">

                        <Label
                                text="Resumen"
                                styleClass="dashboard-section-title"/>

                        <Label
                                text="Información relevante de tu cuenta y próximas atenciones."
                                styleClass="section-helper-text"/>

                    </VBox>

                </HBox>

                <HBox spacing="16">

                    <!-- Próxima cita -->

                    <VBox
                            spacing="9"
                            prefWidth="310"
                            minHeight="150"
                            HBox.hgrow="ALWAYS"
                            styleClass="dashboard-card dashboard-card-primary">

                        <padding>
                            <Insets top="19" right="20" bottom="19" left="20"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT">

                            <Label
                                    text="PRÓXIMA CITA"
                                    styleClass="card-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label
                                    text="PRÓXIMA"
                                    styleClass="card-badge-blue"/>

                        </HBox>

                        <Label
                                fx:id="lblProximaCita"
                                text="Sin citas próximas"
                                wrapText="true"
                                styleClass="card-value"/>

                        <Label
                                fx:id="lblDetalleProximaCita"
                                text="Agenda una nueva cita médica"
                                wrapText="true"
                                styleClass="card-description"/>

                    </VBox>

                    <!-- Mis citas -->

                    <VBox
                            spacing="9"
                            prefWidth="220"
                            minHeight="150"
                            HBox.hgrow="ALWAYS"
                            styleClass="dashboard-card">

                        <padding>
                            <Insets top="19" right="20" bottom="19" left="20"/>
                        </padding>

                        <Label
                                text="CITAS ACTIVAS"
                                styleClass="card-title"/>

                        <Label
                                fx:id="lblCantidadCitas"
                                text="0"
                                styleClass="stat-number"/>

                        <Label
                                text="Citas programadas"
                                styleClass="card-description"/>

                        <Button
                                text="Consultar citas  →"
                                styleClass="card-link-button"
                                onAction="#abrirMisCitas"/>

                    </VBox>

                    <!-- Cuenta -->

                    <VBox
                            spacing="9"
                            prefWidth="220"
                            minHeight="150"
                            HBox.hgrow="ALWAYS"
                            styleClass="dashboard-card">

                        <padding>
                            <Insets top="19" right="20" bottom="19" left="20"/>
                        </padding>

                        <Label
                                text="ESTADO DE CUENTA"
                                styleClass="card-title"/>

                        <HBox
                                spacing="7"
                                alignment="CENTER_LEFT">

                            <Label
                                    text="●"
                                    styleClass="account-active-dot"/>

                            <Label
                                    text="Activa"
                                    styleClass="account-active-text"/>

                        </HBox>

                        <Label
                                text="Tu cuenta se encuentra habilitada para gestionar citas."
                                wrapText="true"
                                styleClass="card-description"/>

                    </VBox>

                </HBox>

            </VBox>

            <!-- =================================================
                           ACCIONES RÁPIDAS
                 ================================================= -->

            <VBox spacing="12">

                <VBox spacing="3">

                    <Label
                            text="Accesos rápidos"
                            styleClass="dashboard-section-title"/>

                    <Label
                            text="Realiza las operaciones más frecuentes."
                            styleClass="section-helper-text"/>

                </VBox>

                <HBox spacing="14">

                    <Button
                            text="+  Agendar cita"
                            prefHeight="58"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="patient-action-card patient-action-primary"
                            onAction="#abrirAgendarCita"/>

                    <Button
                            text="▣  Consultar mis citas"
                            prefHeight="58"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="patient-action-card"
                            onAction="#abrirMisCitas"/>

                    <Button
                            text="◷  Historial médico"
                            prefHeight="58"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="patient-action-card"
                            onAction="#abrirHistorial"/>

                    <Button
                            text="●  Mi perfil"
                            prefHeight="58"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS"
                            styleClass="patient-action-card"
                            onAction="#abrirPerfil"/>

                </HBox>

            </VBox>

            <!-- =================================================
                         MENSAJE INFORMATIVO
                 ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="16"
                    styleClass="patient-info-panel">

                <padding>
                    <Insets top="16" right="20" bottom="16" left="20"/>
                </padding>

                <Label
                        text="i"
                        styleClass="patient-info-icon"/>

                <VBox spacing="3">

                    <Label
                            text="Tu salud, mejor organizada"
                            styleClass="patient-info-title"/>

                    <Label
                            text="Consulta disponibilidad médica, administra tus próximas citas y revisa el historial de atenciones registradas."
                            wrapText="true"
                            styleClass="patient-info-description"/>

                </VBox>

            </HBox>

        </VBox>

    </center>

</BorderPane>