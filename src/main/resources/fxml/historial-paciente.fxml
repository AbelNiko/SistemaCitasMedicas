<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.HistorialPacienteController"
        prefWidth="1180.0"
        prefHeight="720.0"
        stylesheets="@../css/mediappoint.css"
        styleClass="dashboard-root">

    <!-- =========================================================
                         BARRA LATERAL
         ========================================================= -->
    <left>

        <VBox
                prefWidth="230.0"
                spacing="10.0"
                styleClass="dashboard-sidebar">

            <padding>
                <Insets
                        top="28.0"
                        right="18.0"
                        bottom="24.0"
                        left="18.0"/>
            </padding>

            <!-- Marca -->
            <VBox spacing="2.0">

                <Label
                        text="MediAppoint"
                        styleClass="sidebar-brand"/>

                <Label
                        text="Gestión de citas médicas"
                        styleClass="sidebar-subtitle"/>

            </VBox>

            <Region prefHeight="25.0"/>

            <!-- Navegación -->
            <Label
                    text="NAVEGACIÓN"
                    styleClass="sidebar-section-label"/>

            <Button
                    text="Inicio"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#abrirInicio"
                    styleClass="sidebar-button"/>

            <Button
                    text="Agendar cita"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#abrirAgendarCita"
                    styleClass="sidebar-button"/>

            <Button
                    text="Mis citas"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#abrirMisCitas"
                    styleClass="sidebar-button"/>

            <Button
                    text="Historial"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#abrirHistorial"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="Mi perfil"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#abrirPerfil"
                    styleClass="sidebar-button"/>

            <!-- Empuja la sesión hacia abajo -->
            <Region VBox.vgrow="ALWAYS"/>

            <VBox
                    spacing="4.0"
                    styleClass="sidebar-user-box">

                <Label
                        text="PACIENTE"
                        styleClass="sidebar-user-role"/>

                <Label
                        fx:id="lblNombreUsuario"
                        text="Usuario"
                        wrapText="true"
                        styleClass="sidebar-user-name"/>

            </VBox>

            <Button
                    text="Cerrar sesión"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    onAction="#cerrarSesion"
                    styleClass="sidebar-logout-button"/>

        </VBox>

    </left>

    <!-- =========================================================
                         CONTENIDO PRINCIPAL
         ========================================================= -->
    <center>

        <VBox
                spacing="22.0"
                styleClass="dashboard-content">

            <padding>
                <Insets
                        top="32.0"
                        right="38.0"
                        bottom="32.0"
                        left="38.0"/>
            </padding>

            <!-- Encabezado -->
            <HBox
                    alignment="CENTER_LEFT"
                    spacing="18.0">

                <VBox spacing="5.0">

                    <Label
                            text="Historial de atenciones"
                            styleClass="dashboard-title"/>

                    <Label
                            text="Consulta las atenciones médicas que ya fueron realizadas."
                            styleClass="dashboard-description"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Contador -->
                <VBox
                        alignment="CENTER"
                        spacing="2.0"
                        minWidth="125.0"
                        styleClass="history-counter-card">

                    <Label
                            fx:id="lblCantidadAtenciones"
                            text="0"
                            styleClass="history-counter-number"/>

                    <Label
                            text="ATENCIONES"
                            styleClass="history-counter-label"/>

                </VBox>

            </HBox>

            <!-- Mensaje -->
            <Label
                    fx:id="lblMensaje"
                    text=""
                    visible="false"
                    managed="false"
                    wrapText="true"
                    styleClass="dashboard-message"/>

            <!-- Información -->
            <HBox
                    spacing="12.0"
                    alignment="CENTER_LEFT"
                    styleClass="history-info-banner">

                <VBox spacing="3.0">

                    <Label
                            text="Historial médico básico"
                            styleClass="history-banner-title"/>

                    <Label
                            text="Aquí se muestran únicamente las citas que fueron registradas como atendidas por el personal médico."
                            wrapText="true"
                            styleClass="history-banner-text"/>

                </VBox>

            </HBox>

            <!-- Título de sección -->
            <HBox alignment="CENTER_LEFT">

                <VBox spacing="3.0">

                    <Label
                            text="Atenciones realizadas"
                            styleClass="history-section-title"/>

                    <Label
                            text="Las atenciones más recientes aparecen primero."
                            styleClass="history-section-subtitle"/>

                </VBox>

            </HBox>

            <!-- =================================================
                              LISTADO DE HISTORIAL
                 ================================================= -->
            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    hbarPolicy="NEVER"
                    styleClass="history-scroll-pane">

                <content>

                    <VBox
                            fx:id="contenedorHistorial"
                            spacing="16.0"
                            fillWidth="true">

                        <padding>
                            <Insets
                                    top="4.0"
                                    right="8.0"
                                    bottom="20.0"
                                    left="4.0"/>
                        </padding>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>