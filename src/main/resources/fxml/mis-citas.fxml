<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.MisCitasController"
        stylesheets="@../css/mediappoint.css"
        styleClass="dashboard-root"
        prefWidth="1050"
        prefHeight="680">

    <!-- =========================================================
                         MENÚ LATERAL
         ========================================================= -->

    <left>

        <VBox
                prefWidth="220"
                spacing="8"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="28"
                        right="18"
                        bottom="22"
                        left="18"/>
            </padding>

            <Label
                    text="MediAppoint"
                    styleClass="sidebar-brand"/>

            <Label
                    text="GESTIÓN DE CITAS MÉDICAS"
                    styleClass="sidebar-subtitle"/>

            <Region prefHeight="25"/>

            <Button
                    text="Inicio"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"
                    onAction="#volverDashboard"/>

            <Button
                    text="Agendar cita"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"
                    onAction="#abrirAgendarCita"/>

            <Button
                    text="Mis citas"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button-active"/>

            <Button
                    text="Mi perfil"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>

            <Button
                    text="Cerrar sesión"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="logout-button"/>

        </VBox>

    </left>

    <!-- =========================================================
                            CABECERA
         ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                prefHeight="82"
                spacing="15"
                styleClass="dashboard-header">

            <padding>
                <Insets
                        top="15"
                        right="28"
                        bottom="15"
                        left="28"/>
            </padding>

            <Label
                    text="Mis citas"
                    styleClass="dashboard-page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="3">

                <Label
                        fx:id="lblNombreUsuario"
                        text="Usuario"
                        styleClass="dashboard-user-name"/>

                <Label
                        text="PACIENTE"
                        styleClass="dashboard-user-role"/>

            </VBox>

        </HBox>

    </top>

    <!-- =========================================================
                           CONTENIDO
         ========================================================= -->

    <center>

        <VBox
                spacing="20"
                styleClass="dashboard-content">

            <padding>
                <Insets
                        top="30"
                        right="35"
                        bottom="30"
                        left="35"/>
            </padding>

            <VBox spacing="5">

                <Label
                        text="Tus citas médicas"
                        styleClass="welcome-title"/>

                <Label
                        text="Consulta el detalle y estado de tus citas registradas."
                        styleClass="welcome-subtitle"/>

            </VBox>

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="10">

                <Label
                        text="Citas registradas:"
                        styleClass="card-description"/>

                <Label
                        fx:id="lblCantidadCitas"
                        text="0"
                        styleClass="card-accent"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="Agendar nueva cita"
                        prefHeight="40"
                        styleClass="primary-button"
                        onAction="#abrirAgendarCita"/>

            </HBox>

            <Label
                    fx:id="lblMensaje"
                    text=""
                    wrapText="true"
                    styleClass="card-description"/>

            <ScrollPane
                    fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="appointments-scroll">

                <content>

                    <VBox
                            fx:id="contenedorCitas"
                            spacing="14">

                        <padding>
                            <Insets
                                    top="5"
                                    right="5"
                                    bottom="5"
                                    left="5"/>
                        </padding>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>