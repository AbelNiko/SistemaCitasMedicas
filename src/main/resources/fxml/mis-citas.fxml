<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.MisCitasController"
        stylesheets="@../css/mediappoint.css"
        styleClass="dashboard-root"
        prefWidth="1180"
        prefHeight="720">

    <!-- =========================================================
                         MENÚ LATERAL
         ========================================================= -->

    <left>

        <VBox
                prefWidth="235"
                spacing="8"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="32"
                        right="18"
                        bottom="22"
                        left="18"/>
            </padding>

            <Label
                    text="MediAppoint"
                    styleClass="sidebar-brand"/>

            <Label
                    text="PORTAL DEL PACIENTE"
                    styleClass="sidebar-subtitle"/>

            <Region prefHeight="28"/>

            <Label
                    text="NAVEGACIÓN"
                    styleClass="sidebar-section-label"/>

            <Region prefHeight="8"/>

            <Button
                    text="⌂   Inicio"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#volverDashboard"/>

            <Button
                    text="+   Agendar cita"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#abrirAgendarCita"/>

            <Button
                    text="≡   Mis citas"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button-active"
                    onAction="#abrirMisCitas"/>

            <Button
                    text="●   Mi perfil"
                    maxWidth="Infinity"
                    prefHeight="44"
                    styleClass="sidebar-button"
                    onAction="#abrirPerfil"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox
                    spacing="3"
                    styleClass="sidebar-user-card">

                <Label
                        text="PACIENTE"
                        styleClass="sidebar-user-role"/>

                <Label
                        fx:id="lblNombreUsuario"
                        text="Usuario"
                        wrapText="true"
                        styleClass="sidebar-user-name"/>

            </VBox>

            <Region prefHeight="10"/>

            <Separator/>

            <Button
                    text="↪   Cerrar sesión"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="logout-button"
                    onAction="#cerrarSesion"/>

        </VBox>

    </left>

    <!-- =========================================================
                              CABECERA
         ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                prefHeight="82"
                spacing="15"
                styleClass="dashboard-header">

            <padding>
                <Insets
                        top="15"
                        right="30"
                        bottom="15"
                        left="32"/>
            </padding>

            <VBox spacing="3">

                <Label
                        text="Mis citas"
                        styleClass="dashboard-page-title"/>

                <Label
                        text="Consulta y administra tus atenciones médicas"
                        styleClass="dashboard-page-subtitle"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="3">

                <Label
                        text="GESTIÓN PERSONAL"
                        styleClass="header-context-label"/>

                <Label
                        text="CITAS MÉDICAS"
                        styleClass="header-context-value"/>

            </VBox>

        </HBox>

    </top>

    <!-- =========================================================
                         CONTENIDO PRINCIPAL
         ========================================================= -->

    <center>

        <VBox
                spacing="18"
                styleClass="appointments-page">

            <padding>
                <Insets
                        top="26"
                        right="34"
                        bottom="28"
                        left="34"/>
            </padding>

            <!-- =================================================
                            HERO / INTRODUCCIÓN
                 ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="20"
                    styleClass="appointments-hero">

                <padding>
                    <Insets
                            top="20"
                            right="22"
                            bottom="20"
                            left="22"/>
                </padding>

                <VBox spacing="6">

                    <Label
                            text="GESTIÓN DE ATENCIONES"
                            styleClass="section-eyebrow"/>

                    <Label
                            text="Tus citas médicas"
                            styleClass="appointments-title"/>

                    <Label
                            text="Revisa el estado, fecha, profesional y establecimiento de cada cita registrada."
                            wrapText="true"
                            styleClass="appointments-subtitle"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        text="+  Agendar nueva cita"
                        prefHeight="42"
                        styleClass="primary-button"
                        onAction="#abrirAgendarCita"/>

            </HBox>

            <!-- =================================================
                           RESUMEN Y FILTROS
                 ================================================= -->

            <HBox
                    spacing="14"
                    alignment="CENTER_LEFT">

                <VBox
                        prefWidth="180"
                        spacing="5"
                        styleClass="appointments-summary-card">

                    <Label
                            text="CITAS MOSTRADAS"
                            styleClass="summary-label"/>

                    <HBox
                            spacing="8"
                            alignment="CENTER_LEFT">

                        <Label
                                fx:id="lblCantidadCitas"
                                text="0"
                                styleClass="summary-number"/>

                        <Label
                                text="registros"
                                styleClass="summary-caption"/>

                    </HBox>

                </VBox>

                <VBox
                        spacing="8"
                        HBox.hgrow="ALWAYS"
                        styleClass="appointments-filter-card">

                    <Label
                            text="BUSCAR Y FILTRAR"
                            styleClass="summary-label"/>

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10">

                        <TextField
                                fx:id="txtBuscarCita"
                                promptText="Buscar por especialidad, médico, establecimiento o motivo..."
                                prefHeight="40"
                                HBox.hgrow="ALWAYS"
                                styleClass="appointments-search-field"/>

                        <ComboBox
                                fx:id="cmbEstado"
                                promptText="Estado"
                                prefWidth="175"
                                prefHeight="40"
                                styleClass="appointments-filter-combo"/>

                        <Button
                                text="Limpiar"
                                prefHeight="40"
                                styleClass="secondary-button"
                                onAction="#limpiarFiltros"/>

                    </HBox>

                </VBox>

            </HBox>

            <!-- =================================================
                              MENSAJES
                 ================================================= -->

            <Label
                    fx:id="lblMensaje"
                    text=""
                    visible="false"
                    managed="false"
                    wrapText="true"
                    styleClass="appointments-message"/>

            <!-- =================================================
                           ENCABEZADO LISTADO
                 ================================================= -->

            <HBox
                    alignment="CENTER_LEFT"
                    spacing="10">

                <VBox spacing="3">

                    <Label
                            text="CITAS REGISTRADAS"
                            styleClass="section-eyebrow"/>

                    <Label
                            text="Detalle de tus solicitudes y atenciones"
                            styleClass="appointments-list-title"/>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="Los estados se actualizan según el proceso de atención."
                        styleClass="appointments-helper"/>

            </HBox>

            <!-- =================================================
                            LISTADO DE CITAS
                 ================================================= -->

            <ScrollPane
                    fitToWidth="true"
                    fitToHeight="false"
                    pannable="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="appointments-scroll">

                <content>

                    <VBox
                            fx:id="contenedorCitas"
                            spacing="14"
                            fillWidth="true"
                            styleClass="appointments-list">

                        <padding>
                            <Insets
                                    top="4"
                                    right="6"
                                    bottom="16"
                                    left="4"/>
                        </padding>

                    </VBox>

                </content>

            </ScrollPane>

        </VBox>

    </center>

</BorderPane>