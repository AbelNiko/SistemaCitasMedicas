<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.PerfilController"
        stylesheets="@../css/mediappoint.css"
        styleClass="dashboard-root"
        prefWidth="1050"
        prefHeight="680">

    <!-- =========================================================
                         MENÚ LATERAL
         ========================================================= -->

    <left>

        <VBox
                prefWidth="220"
                spacing="8"
                styleClass="sidebar">

            <padding>
                <Insets
                        top="28"
                        right="18"
                        bottom="22"
                        left="18"/>
            </padding>

            <Label
                    text="MediAppoint"
                    styleClass="sidebar-brand"/>

            <Label
                    text="GESTIÓN DE CITAS MÉDICAS"
                    styleClass="sidebar-subtitle"/>

            <Region prefHeight="25"/>

            <Button
                    text="Inicio"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"
                    onAction="#volverDashboard"/>

            <Button
                    text="Agendar cita"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"
                    onAction="#abrirAgendarCita"/>

            <Button
                    text="Mis citas"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button"
                    onAction="#abrirMisCitas"/>

            <Button
                    text="Mi perfil"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="sidebar-button-active"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator/>

            <Button
                    text="Cerrar sesión"
                    maxWidth="Infinity"
                    prefHeight="42"
                    styleClass="logout-button"/>

        </VBox>

    </left>

    <!-- =========================================================
                            CABECERA
         ========================================================= -->

    <top>

        <HBox
                alignment="CENTER_LEFT"
                prefHeight="82"
                spacing="15"
                styleClass="dashboard-header">

            <padding>
                <Insets
                        top="15"
                        right="28"
                        bottom="15"
                        left="28"/>
            </padding>

            <Label
                    text="Mi perfil"
                    styleClass="dashboard-page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <VBox
                    alignment="CENTER_RIGHT"
                    spacing="3">

                <Label
                        fx:id="lblNombreUsuario"
                        text="Usuario"
                        styleClass="dashboard-user-name"/>

                <Label
                        text="PACIENTE"
                        styleClass="dashboard-user-role"/>

            </VBox>

        </HBox>

    </top>

    <!-- =========================================================
                           CONTENIDO
         ========================================================= -->

    <center>

        <VBox
                spacing="22"
                styleClass="dashboard-content">

            <padding>
                <Insets
                        top="30"
                        right="35"
                        bottom="30"
                        left="35"/>
            </padding>

            <VBox spacing="5">

                <Label
                        text="Información personal"
                        styleClass="welcome-title"/>

                <Label
                        text="Consulta y administra la información asociada a tu cuenta."
                        styleClass="welcome-subtitle"/>

            </VBox>

            <VBox
                    spacing="20"
                    maxWidth="720"
                    styleClass="dashboard-card">

                <padding>
                    <Insets
                            top="25"
                            right="28"
                            bottom="25"
                            left="28"/>
                </padding>

                <Label
                        text="Datos de la cuenta"
                        styleClass="dashboard-section-title"/>

                <GridPane
                        hgap="20"
                        vgap="16">

                    <Label
                            text="Nombres"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"
                            styleClass="card-description"/>

                    <TextField
                            fx:id="txtNombres"
                            prefWidth="280"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                    <Label
                            text="Apellidos"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"
                            styleClass="card-description"/>

                    <TextField
                            fx:id="txtApellidos"
                            prefWidth="280"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                    <Label
                            text="Cédula"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"
                            styleClass="card-description"/>

                    <TextField
                            fx:id="txtCedula"
                            editable="false"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                    <Label
                            text="Correo electrónico"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"
                            styleClass="card-description"/>

                    <TextField
                            fx:id="txtCorreo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                    <Label
                            text="Teléfono"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="4"
                            styleClass="card-description"/>

                    <TextField
                            fx:id="txtTelefono"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="5"/>

                    <Label
                            text="Dirección"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="4"
                            styleClass="card-description"/>

                    <TextField
                            fx:id="txtDireccion"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="5"/>

                </GridPane>

                <Label
                        fx:id="lblMensaje"
                        text=""
                        wrapText="true"
                        styleClass="card-description"/>

                <HBox
                        alignment="CENTER_RIGHT"
                        spacing="12">

                    <Button
                            text="Cancelar cambios"
                            styleClass="quick-action"
                            onAction="#recargarDatos"/>

                    <Button
                            text="Guardar cambios"
                            styleClass="primary-button"
                            onAction="#guardarCambios"/>

                </HBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>