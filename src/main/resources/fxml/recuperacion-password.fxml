<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.RecuperacionPasswordController"
        stylesheets="@../css/mediappoint.css"
        styleClass="recovery-root"
        spacing="18"
        prefWidth="520"
        prefHeight="610">

    <padding>
        <Insets
                top="30"
                right="34"
                bottom="30"
                left="34"/>
    </padding>

    <VBox spacing="5">

        <Label
                text="Recuperar contraseña"
                styleClass="recovery-title"/>

        <Label
                text="Verifica tu identidad para restablecer el acceso a MediAppoint."
                wrapText="true"
                styleClass="recovery-description"/>

    </VBox>

    <Separator/>

    <!-- =====================================================
                         ETAPA 1
         ===================================================== -->

    <VBox
            fx:id="panelIdentificacion"
            spacing="12">

        <Label
                text="1 · Identifica tu cuenta"
                styleClass="recovery-step-title"/>

        <VBox spacing="6">

            <Label
                    text="Correo electrónico"
                    styleClass="field-label"/>

            <TextField
                    fx:id="txtCorreoRecuperacion"
                    promptText="correo@ejemplo.com"
                    prefHeight="42"
                    styleClass="auth-field"/>

        </VBox>

        <VBox spacing="6">

            <Label
                    text="Cédula"
                    styleClass="field-label"/>

            <TextField
                    fx:id="txtCedulaRecuperacion"
                    promptText="10 dígitos"
                    prefHeight="42"
                    styleClass="auth-field"/>

        </VBox>

        <Button
                fx:id="btnContinuar"
                text="CONTINUAR"
                onAction="#identificarCuenta"
                maxWidth="Infinity"
                prefHeight="44"
                styleClass="primary-button"/>

    </VBox>

    <!-- =====================================================
                         ETAPA 2
         ===================================================== -->

    <VBox
            fx:id="panelPregunta"
            spacing="12"
            visible="false"
            managed="false">

        <Label
                text="2 · Verificación de seguridad"
                styleClass="recovery-step-title"/>

        <VBox
                spacing="5"
                styleClass="recovery-question-card">

            <padding>
                <Insets
                        top="12"
                        right="14"
                        bottom="12"
                        left="14"/>
            </padding>

            <Label
                    text="TU PREGUNTA DE SEGURIDAD"
                    styleClass="recovery-small-label"/>

            <Label
                    fx:id="lblPreguntaSeguridad"
                    text="Pregunta"
                    wrapText="true"
                    styleClass="recovery-question"/>

        </VBox>

        <VBox spacing="6">

            <Label
                    text="Respuesta"
                    styleClass="field-label"/>

            <TextField
                    fx:id="txtRespuestaSeguridad"
                    promptText="Ingresa tu respuesta"
                    prefHeight="42"
                    styleClass="auth-field"/>

            <Label
                    text="Por favor, ingrese la respuesta sin mayúsculas ni tildes."
                    wrapText="true"
                    styleClass="muted-text"/>

        </VBox>

        <Label
                text="Dispones de un máximo de 5 intentos. Si los superas, la recuperación se bloqueará temporalmente."
                wrapText="true"
                styleClass="recovery-warning"/>

        <Button
                fx:id="btnVerificarRespuesta"
                text="VERIFICAR RESPUESTA"
                onAction="#verificarRespuesta"
                maxWidth="Infinity"
                prefHeight="44"
                styleClass="primary-button"/>

    </VBox>

    <!-- =====================================================
                         ETAPA 3
         ===================================================== -->

    <VBox
            fx:id="panelNuevaPassword"
            spacing="12"
            visible="false"
            managed="false">

        <Label
                text="3 · Nueva contraseña"
                styleClass="recovery-step-title"/>

        <VBox spacing="6">

            <Label
                    text="Nueva contraseña"
                    styleClass="field-label"/>

            <PasswordField
                    fx:id="txtNuevaPassword"
                    promptText="Mínimo 8 caracteres"
                    prefHeight="42"
                    styleClass="auth-field"/>

        </VBox>

        <VBox spacing="6">

            <Label
                    text="Confirmar nueva contraseña"
                    styleClass="field-label"/>

            <PasswordField
                    fx:id="txtConfirmarNuevaPassword"
                    promptText="Repite la nueva contraseña"
                    prefHeight="42"
                    styleClass="auth-field"/>

        </VBox>

        <Button
                fx:id="btnRestablecer"
                text="RESTABLECER CONTRASEÑA"
                onAction="#restablecerPassword"
                maxWidth="Infinity"
                prefHeight="44"
                styleClass="primary-button"/>

    </VBox>

    <Label
            fx:id="lblMensaje"
            text=""
            wrapText="true"
            maxWidth="Infinity"
            styleClass="error-message"/>

    <Button
            text="CERRAR"
            onAction="#cerrarVentana"
            maxWidth="Infinity"
            prefHeight="42"
            styleClass="secondary-button"/>

</VBox>