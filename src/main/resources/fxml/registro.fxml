<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.RegistroController"
        stylesheets="@../css/mediappoint.css"
        styleClass="registration-scroll"
        fitToWidth="true"
        prefWidth="650"
        prefHeight="760">

    <content>

        <VBox
                alignment="TOP_CENTER"
                spacing="20"
                styleClass="registration-container">

            <padding>
                <Insets
                        top="32"
                        right="55"
                        bottom="40"
                        left="55"/>
            </padding>

            <!-- =================================================
                                 MARCA
                 ================================================= -->

            <VBox
                    alignment="CENTER"
                    spacing="5">

                <Label
                        text="MediAppoint"
                        styleClass="brand-title"/>

                <Label
                        text="Sistema de Gestión y Agendamiento de Citas Médicas"
                        styleClass="brand-subtitle"/>

            </VBox>

            <!-- =================================================
                              TARJETA PRINCIPAL
                 ================================================= -->

            <VBox
                    spacing="17"
                    maxWidth="520"
                    styleClass="registration-card">

                <padding>
                    <Insets
                            top="28"
                            right="32"
                            bottom="30"
                            left="32"/>
                </padding>

                <!-- Encabezado -->

                <VBox
                        alignment="CENTER"
                        spacing="6">

                    <Label
                            text="Crear cuenta"
                            styleClass="auth-title"/>

                    <Label
                            text="Completa tus datos para registrarte como paciente"
                            styleClass="auth-description"/>

                </VBox>

                <Separator/>

                <!-- =================================================
                                  DATOS PERSONALES
                     ================================================= -->

                <Label
                        text="Datos personales"
                        styleClass="section-title"/>

                <HBox spacing="12">

                    <VBox
                            spacing="6"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="Nombres"
                                styleClass="field-label"/>

                        <TextField
                                fx:id="txtNombres"
                                promptText="Tus nombres"
                                prefHeight="40"
                                styleClass="auth-field"/>

                    </VBox>

                    <VBox
                            spacing="6"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="Apellidos"
                                styleClass="field-label"/>

                        <TextField
                                fx:id="txtApellidos"
                                promptText="Tus apellidos"
                                prefHeight="40"
                                styleClass="auth-field"/>

                    </VBox>

                </HBox>

                <VBox spacing="6">

                    <Label
                            text="Cédula"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="txtCedula"
                            promptText="10 dígitos"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <HBox spacing="12">

                    <VBox
                            spacing="6"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="Fecha de nacimiento"
                                styleClass="field-label"/>

                        <DatePicker
        fx:id="dpFechaNacimiento"
        editable="false"
        promptText="Selecciona una fecha"
        prefHeight="40"
        maxWidth="Infinity"
        styleClass="auth-date-picker"/>

                    </VBox>

                    <VBox
                            spacing="6"
                            HBox.hgrow="ALWAYS">

                        <Label
                                text="Sexo"
                                styleClass="field-label"/>

                        <ComboBox
                                fx:id="cmbSexo"
                                promptText="Seleccionar"
                                prefHeight="40"
                                maxWidth="Infinity"
                                styleClass="auth-combo"/>

                    </VBox>

                </HBox>

                <VBox spacing="6">

                    <Label
                            text="Dirección"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="txtDireccion"
                            promptText="Dirección domiciliaria"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <VBox spacing="6">

                    <Label
                            text="Teléfono"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="txtTelefono"
                            promptText="Número de teléfono"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <!-- =================================================
                                  DATOS DE CUENTA
                     ================================================= -->

                <Separator/>

                <Label
                        text="Datos de la cuenta"
                        styleClass="section-title"/>

                <VBox spacing="6">

                    <Label
                            text="Correo electrónico"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="txtCorreo"
                            promptText="ejemplo@correo.com"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <VBox spacing="6">

                    <Label
                            text="Contraseña"
                            styleClass="field-label"/>

                    <PasswordField
                            fx:id="txtPassword"
                            promptText="Mínimo 8 caracteres"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <VBox spacing="6">

                    <Label
                            text="Confirmar contraseña"
                            styleClass="field-label"/>

                    <PasswordField
                            fx:id="txtConfirmarPassword"
                            promptText="Repite tu contraseña"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

<!-- =================================================
              SEGURIDAD DE LA CUENTA
     ================================================= -->

<Separator/>

<Label
        text="Seguridad de la cuenta"
        styleClass="section-title"/>

<Label
        text="Selecciona una pregunta que puedas recordar. Se utilizará para verificar tu identidad si necesitas recuperar tu contraseña."
        wrapText="true"
        styleClass="info-text"/>

<VBox spacing="6">

    <Label
            text="Pregunta de seguridad"
            styleClass="field-label"/>

    <ComboBox
            fx:id="cmbPreguntaSeguridad"
            promptText="Selecciona una pregunta"
            prefHeight="40"
            maxWidth="Infinity"
            styleClass="auth-combo"/>

</VBox>

<VBox spacing="6">

    <Label
            text="Respuesta de seguridad"
            styleClass="field-label"/>

    <TextField
            fx:id="txtRespuestaSeguridad"
            promptText="Ej.: matematicas"
            prefHeight="40"
            styleClass="auth-field"/>

    <Label
            text="Por favor, ingrese la respuesta sin mayúsculas ni tildes."
            wrapText="true"
            styleClass="muted-text"/>

</VBox>


                <!-- =================================================
                              CONTACTO DE EMERGENCIA
                     ================================================= -->

                <Separator/>

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="8">

                    <Label
                            text="Contacto de emergencia"
                            styleClass="section-title"/>

                    <Label
                            text="(opcional)"
                            styleClass="optional-text"/>

                </HBox>

                <VBox spacing="6">

                    <Label
                            text="Nombre del contacto"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="txtContactoEmergencia"
                            promptText="Nombre completo"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <VBox spacing="6">

                    <Label
                            text="Teléfono de emergencia"
                            styleClass="field-label"/>

                    <TextField
                            fx:id="txtTelefonoEmergencia"
                            promptText="Número de teléfono"
                            prefHeight="40"
                            styleClass="auth-field"/>

                </VBox>

                <!-- Mensajes -->

                <Label
                        fx:id="lblMensaje"
                        text=""
                        wrapText="true"
                        maxWidth="Infinity"
                        styleClass="error-message"/>

                <Region prefHeight="2"/>

                <!-- Crear cuenta -->

                <Button
        fx:id="btnCrearCuenta"
        text="CREAR CUENTA"
        onAction="#registrarPaciente"
        maxWidth="Infinity"
        prefHeight="45"
        styleClass="primary-button"/>

                <!-- Regresar -->

                <Button
                        text="VOLVER AL INICIO DE SESIÓN"
                        onAction="#volverLogin"
                        maxWidth="Infinity"
                        prefHeight="42"
                        styleClass="secondary-button"/>

                <!-- Información -->

                <VBox
                        alignment="CENTER"
                        spacing="3"
                        styleClass="info-box">

                    <padding>
                        <Insets
                                top="10"
                                right="12"
                                bottom="10"
                                left="12"/>
                    </padding>

                    <Label
                            text="Registro exclusivo para pacientes"
                            styleClass="field-label"/>

                    <Label
                            text="Las cuentas del personal médico y administrativo son creadas por el administrador del sistema."
                            textAlignment="CENTER"
                            alignment="CENTER"
                            wrapText="true"
                            maxWidth="420"
                            styleClass="info-text"/>

                </VBox>

            </VBox>

            <Label
                    text="MediAppoint · Gestión segura de citas médicas"
                    styleClass="muted-text"/>

        </VBox>

    </content>

</ScrollPane>