<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.citasmedicas.controller.RegistroController"
        fitToWidth="true"
        prefWidth="600"
        prefHeight="720">

    <content>

        <VBox
                alignment="TOP_CENTER"
                spacing="15"
                style="-fx-background-color: #071525;">

            <padding>
                <Insets
                        top="35"
                        right="55"
                        bottom="35"
                        left="55"/>
            </padding>

            <Label
                    text="MediAppoint"
                    style="
                        -fx-font-size: 30px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #1597ff;
                    "/>

            <Label
                    text="Crear cuenta"
                    style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                        -fx-text-fill: white;
                    "/>

            <Label
                    text="Registra tus datos para gestionar tus citas médicas"
                    wrapText="true"
                    style="
                        -fx-text-fill: #b8c5d6;
                        -fx-font-size: 13px;
                    "/>

            <Label
                    text="Datos personales"
                    maxWidth="Infinity"
                    style="
                        -fx-text-fill: #18b9ff;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                    "/>

            <HBox spacing="10">

                <TextField
                        fx:id="txtNombres"
                        promptText="Nombres"
                        HBox.hgrow="ALWAYS"/>

                <TextField
                        fx:id="txtApellidos"
                        promptText="Apellidos"
                        HBox.hgrow="ALWAYS"/>

            </HBox>

            <TextField
                    fx:id="txtCedula"
                    promptText="Cédula"/>

            <DatePicker
                    fx:id="dpFechaNacimiento"
                    promptText="Fecha de nacimiento"
                    maxWidth="Infinity"/>

            <ComboBox
                    fx:id="cmbSexo"
                    promptText="Sexo"
                    maxWidth="Infinity"/>

            <TextField
                    fx:id="txtDireccion"
                    promptText="Dirección"/>

            <TextField
                    fx:id="txtTelefono"
                    promptText="Teléfono"/>

            <Label
                    text="Datos de la cuenta"
                    maxWidth="Infinity"
                    style="
                        -fx-text-fill: #18b9ff;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                    "/>

            <TextField
                    fx:id="txtCorreo"
                    promptText="Correo electrónico"/>

            <PasswordField
                    fx:id="txtPassword"
                    promptText="Contraseña"/>

            <PasswordField
                    fx:id="txtConfirmarPassword"
                    promptText="Confirmar contraseña"/>

            <Label
                    text="Contacto de emergencia"
                    maxWidth="Infinity"
                    style="
                        -fx-text-fill: #18b9ff;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                    "/>

            <TextField
                    fx:id="txtContactoEmergencia"
                    promptText="Nombre del contacto"/>

            <TextField
                    fx:id="txtTelefonoEmergencia"
                    promptText="Teléfono del contacto"/>

            <Label
                    fx:id="lblMensaje"
                    text=""
                    wrapText="true"
                    maxWidth="Infinity"
                    style="
                        -fx-text-fill: #ff6b6b;
                        -fx-font-size: 13px;
                    "/>

            <Button
                    text="Crear cuenta"
                    onAction="#registrarPaciente"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="
                        -fx-background-color: #087df5;
                        -fx-text-fill: white;
                        -fx-font-size: 14px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 6;
                    "/>

            <Button
                    text="Volver al inicio de sesión"
                    onAction="#volverLogin"
                    maxWidth="Infinity"
                    prefHeight="40"
                    style="
                        -fx-background-color: transparent;
                        -fx-border-color: #9ba9b8;
                        -fx-text-fill: white;
                        -fx-border-radius: 6;
                    "/>

            <Label
                    text="¿Eres parte del personal médico o administrativo? Solicita la creación de tu cuenta al administrador del sistema."
                    wrapText="true"
                    maxWidth="Infinity"
                    style="
                        -fx-text-fill: #9ba9b8;
                        -fx-font-size: 12px;
                    "/>

        </VBox>

    </content>

</ScrollPane>